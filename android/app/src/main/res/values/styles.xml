<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema da janela enquanto o app abre. O CritHit é sempre escuro, então
         claro e escuro do sistema usam o mesmo fundo da marca. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Tema atrás da interface Flutter depois que ela desenha o primeiro quadro. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/crithit_background</item>
    </style>
</resources>
