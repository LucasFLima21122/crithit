<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: a splash do sistema usa o fundo escuro da marca em vez
         do branco padrão. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/crithit_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@color/crithit_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/crithit_background</item>
    </style>
</resources>
